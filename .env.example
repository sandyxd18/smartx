# Salin ke .env (make melakukannya otomatis). Jangan commit .env.

# Tanggal rilis OSS CAD Suite yang sudah teruji, format YYYY-MM-DD.
# `make pin-toolchain` menggantinya dengan rilis terbaru (lalu jalankan make check-content).
OSS_CAD_SUITE_DATE=2026-10-24

# Image untuk job ASIC (Fase 5). Pin ke tag tertentu, jangan "latest".
ASIC_IMAGE=hpretl/iic-osic-tools:CHANGE_ME

# Lokasi data runtime (database, workspace, hasil run). Di-gitignore.
SMARTX_DATA_DIR=./data
# Baca ulang exercise.yaml yang berubah tanpa restart backend.
SMARTX_CONTENT_RELOAD=true

# Alamat yang dibuka di browser (UI; /api diteruskan ke backend). Hanya localhost.
# Ubah ke 0.0.0.0 hanya jika ada reverse proxy + auth di depannya.
SMARTX_BIND=127.0.0.1
SMARTX_PORT=8080
# Backend untuk dev server Vite di host (tanpa compose). Di compose: http://backend:8000.
SMARTX_API_URL=http://127.0.0.1:8000

# Batas job
JOB_LIGHT_CONCURRENCY=2
JOB_HEAVY_CONCURRENCY=1
JOB_LIGHT_TIMEOUT_S=120
JOB_HEAVY_TIMEOUT_S=7200
JOB_LIGHT_MEMORY=4g
JOB_HEAVY_MEMORY=12g
JOB_LIGHT_CPUS=2
JOB_HEAVY_CPUS=4
JOB_PIDS_LIMIT=512
# uid:gid untuk container job. Kosong = uid:gid backend (di Windows: 1000:1000, user 'smartx' di image).
JOB_USER=

# Hanya jika backend sendiri berjalan di container: path folder data/ dan content/ menurut host Docker.
SMARTX_HOST_DATA_DIR=
SMARTX_HOST_CONTENT_DIR=
SMARTX_HOST_TOOLS_DIR=
